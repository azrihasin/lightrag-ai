# ── AI Provider ─────────────────────────────────────────────────────────────
# Provider to use: "openai" or "anthropic"
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# OpenAI
OPENAI_API_KEY=

# Anthropic (required when AI_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=

# ── LightRAG ─────────────────────────────────────────────────────────────────
LIGHTRAG_API_URL=http://localhost:9621
# Timeout (ms) for LightRAG context-retrieval requests. Default: 30000
LIGHTRAG_TIMEOUT_MS=30000
# Entities/relations LightRAG retrieves per query. Higher = broader table
# coverage (fewer "missing table" SQL errors), more tokens. Default: 12
LIGHTRAG_TOP_K=12
# Max characters of retrieved schema context forwarded to the SQL agent. Raise
# for large schemas so no tables/columns get cut; set 0 to disable truncation.
# Default: 16000
LIGHTRAG_MAX_CONTEXT_CHARS=16000

# ── Main application database (MariaDB / MySQL) ──────────────────────────────
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASSWORD=
MARIADB_DATABASE=minds

# ── Chat history database (defaults to MARIADB_* when omitted) ─────────────────
# CHAT_DB_HOST=localhost
# CHAT_DB_PORT=3306
# CHAT_DB_USER=root
# CHAT_DB_PASSWORD=
CHAT_DB_NAME=minds_chat
CHAT_DB_CONNECTION_LIMIT=10
# Set to "false" to skip storing thinking/reasoning payloads
CHAT_STORE_THINKING=false

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=*
