# ── LLM (DeepSeek via OpenAI-compatible API) ──
AI_MODEL=deepseek-chat
LLM_BINDING_HOST=https://api.deepseek.com
OPENAI_API_KEY=

# To use OpenAI instead, set AI_MODEL above (e.g. gpt-4o-mini) and swap in:
# LLM_BINDING_HOST=https://api.openai.com/v1
# OPENAI_API_KEY=sk-proj-...

# ── Retrieval (LanceDB hybrid search) ──
# Directory holding the LanceDB database (the "lancedb" folder). Defaults to
# {cwd}/lancedb when unset.
LANCEDB_DIR=
# Embedding model used to embed retrieval queries. MUST match the model that
# produced the stored vectors (text-embedding-3-large, 3072-dim). Resolved via
# the same OpenAI-compatible LLM_BINDING_HOST / OPENAI_API_KEY above, so point
# those at an embedding-capable endpoint.
EMBEDDING_MODEL=text-embedding-3-large

# ── MariaDB ──
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASSWORD=
MARIADB_DATABASE=minds
