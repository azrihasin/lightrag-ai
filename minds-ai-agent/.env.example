# ── Server ──
# Port 3000 is taken by the rag-web-ui Next.js app, so the backend runs on 3001.
PORT=3001
CORS_ORIGIN=*

# ── LLM (DeepSeek via OpenAI-compatible API) ──
AI_MODEL=deepseek-chat
LLM_BINDING_HOST=https://api.deepseek.com
OPENAI_API_KEY=your-api-key-here

# To use OpenAI instead, set AI_MODEL above (e.g. gpt-4o-mini) and swap in:
# LLM_BINDING_HOST=https://api.openai.com/v1
# OPENAI_API_KEY=sk-proj-...

# ── LightRAG ──
LIGHTRAG_API_URL=http://localhost:9621

# ── MariaDB ──
# These same credentials are used by DuckDB to ATTACH MariaDB in READ-ONLY mode
# (via the DuckDB `mysql` extension) for all analytical execution. The extension
# auto-downloads on first run (`INSTALL mysql`) and is then cached for offline use.
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASSWORD=root
MARIADB_DATABASE=minds
