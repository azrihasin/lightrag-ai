# Required for the chat API - get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here

# minds-ai-agent backend. Port 3000 is taken by the rag-web-ui Next.js app, so the backend runs on 3001.
VITE_API_URL=http://localhost:3001/api/chat
CHAT_URL=http://localhost:3001/api/chat
